# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kyzen_crm

# ──────────────────────────────────────────────
# Cache / Queue (Redis)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────
AUTH_SECRET=replace_with_long_random_secret_at_least_64_chars
SESSION_SECRET=replace_with_another_long_random_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ──────────────────────────────────────────────
# Email Provider (SendGrid, Mailgun, Resend, etc.)
# ──────────────────────────────────────────────
EMAIL_PROVIDER=
# Supported: sendgrid | mailgun | resend
EMAIL_API_KEY=
EMAIL_FROM_NAME=Kyzen Sales
EMAIL_FROM_ADDRESS=sales@yourdomain.com
EMAIL_WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# WhatsApp Business Platform (Meta Cloud API)
# ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ──────────────────────────────────────────────
# Source Connectors
# ──────────────────────────────────────────────
TWOGIS_API_KEY=
BUSINESS_DIRECTORY_API_KEY=
LICENSED_DATA_PROVIDER_API_KEY=

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=info

# ──────────────────────────────────────────────
# File Uploads
# ──────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./uploads

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
