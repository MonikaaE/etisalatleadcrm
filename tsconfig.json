{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "composite": true,
    "paths": {
      "@kyzen/shared": ["./packages/shared/src/index.ts"],
      "@kyzen/config": ["./packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**"]
}
